{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Python: Create virtual environment",
            "type": "shell",
            "command": "python3 -m venv \"${workspaceFolder}/madsheild/backend/.venv\"",
            "problemMatcher": []
        },
        {
            "label": "Python: Install backend dependencies",
            "type": "shell",
            "command": "\"${workspaceFolder}/madsheild/backend/.venv/bin/python\" -m pip install -r \"${workspaceFolder}/madsheild/backend/requirements.txt\"",
            "dependsOn": "Python: Create virtual environment",
            "problemMatcher": []
        },
        {
            "label": "Backend: Start FastAPI",
            "type": "shell",
            "command": "\"${workspaceFolder}/madsheild/backend/.venv/bin/python\" -m uvicorn main:app --reload --host 127.0.0.1 --port 8001",
            "options": {
                "cwd": "${workspaceFolder}/madsheild/backend"
            },
            "problemMatcher": [],
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "dependsOn": "Python: Install backend dependencies"
        },
        {
            "label": "MadSheild: Start development services",
            "dependsOn": "Backend: Start FastAPI",
            "problemMatcher": []
        }
    ]
}
