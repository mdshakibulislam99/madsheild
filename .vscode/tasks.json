{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Python: Create virtual environment",
            "type": "process",
            "command": "py",
            "args": [
                "-m",
                "venv",
                "${workspaceFolder}\\.venv"
            ],
            "windows": {
                "command": "py"
            },
            "problemMatcher": []
        },
        {
            "label": "Python: Install backend dependencies",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": [
                "-m",
                "pip",
                "install",
                "-r",
                "${workspaceFolder}\\madsheild\\backend\\requirements.txt"
            ],
            "dependsOn": "Python: Create virtual environment",
            "problemMatcher": []
        },
        {
            "label": "Backend: Start FastAPI",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": [
                "-m",
                "uvicorn",
                "main:app",
                "--reload",
                "--host",
                "127.0.0.1",
                "--port",
                "8001"
            ],
            "options": {
                "cwd":                 "${workspaceFolder}\\madsheild\\backend"
            },
            "problemMatcher": [],
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "dependsOn": "Python: Install backend dependencies"
        },
        {
            "label": "Backend: Start Django",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": [
                "${workspaceFolder}\\manage.py",
                "runserver",
                "127.0.0.1:8000"
            ],
            "problemMatcher": [],
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "MadSheild: Start development services",
            "dependsOn": "Backend: Start FastAPI",
            "problemMatcher": []
        }
    ]
}
