#!/usr/bin/env python3
"""MadSheild launcher installed on the shell PATH.

Usage:
    run dev      Start the development server with automatic reloading.
    run start    Start the server without automatic reloading.
    run test     Run the backend test suite.
    run install  Create the virtual environment and install dependencies.
    run setup    Install this launcher into a directory on your PATH.
    run open     Open the running application in the default browser.
    run info     Show the resolved paths and environment details.

Run ``run`` with no arguments for the full list of options.
"""

import os
import sys

# Resolve the repository that contains this launcher, so the command works
# from any working directory.
_HERE = os.path.dirname(os.path.abspath(os.path.realpath(__file__)))
_CANDIDATES = [
    _HERE,
    os.path.dirname(_HERE),
    os.path.join(os.path.dirname(_HERE), "madsheild"),
    "/Users/mac/STITP/CODE SPACE/madsheild",
    "/Users/mac/STITP/CODE SPACE/madsheild/madsheild",
]

_REPO_ROOT = None
for _candidate in _CANDIDATES:
    if os.path.isfile(os.path.join(_candidate, "madsheild", "cli.py")):
        _REPO_ROOT = _candidate
        break

if _REPO_ROOT is None:
    sys.stderr.write(
        "run: unable to locate the MadSheild repository.\n"
        "Expected to find 'madsheild/cli.py' next to this launcher.\n"
    )
    sys.exit(1)

sys.path.insert(0, _REPO_ROOT)

try:
    from madsheild.cli import main
except ImportError as error:  # pragma: no cover - defensive launcher guard
    sys.stderr.write(f"run: unable to load the MadSheild CLI ({error}).\n")
    sys.exit(1)

if __name__ == "__main__":
    # Keep the banner and the server output interleaved in the expected order
    # even when the output is redirected to a file or a pipe.
    try:
        sys.stdout.reconfigure(line_buffering=True)
    except AttributeError:  # pragma: no cover - Python versions without reconfigure
        pass
    sys.exit(main())
