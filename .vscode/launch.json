{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI: Debug",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "cwd": "${workspaceFolder}/madsheild/backend",
            "python": "${workspaceFolder}/madsheild/backend/.venv/bin/python",
            "args": [
                "main:app",
                "--reload",
                "--host",
                "127.0.0.1",
                "--port",
                "8001"
            ],
            "jinja": true
        }
    ],
    "compounds": [
        {
            "name": "MadSheild: Debug FastAPI",
            "configurations": [
                "FastAPI: Debug"
            ]
        }
    ]
}
